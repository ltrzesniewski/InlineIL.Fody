<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <DisableFody>true</DisableFody>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <Import Project="../TestLangFeatures.targets" />

  <ItemGroup>
    <PackageReference Include="FodyHelpers" />

    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CSharp" />
    <PackageReference Include="System.Reflection.Metadata" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InlineIL.Fody\InlineIL.Fody.csproj" />
    <ProjectReference Include="..\InlineIL.Tests.Common\InlineIL.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InlineILTestProject Include="..\InlineIL.Tests.AssemblyToProcess\InlineIL.Tests.AssemblyToProcess.csproj" />
    <InlineILTestProject Include="..\InlineIL.Tests.InvalidAssemblyToProcess\InlineIL.Tests.InvalidAssemblyToProcess.csproj" />
    <InlineILTestProject Include="..\InlineIL.Tests.StandardAssemblyToProcess\InlineIL.Tests.StandardAssemblyToProcess.csproj" Aliases="standard" />
    <InlineILTestProject Include="..\InlineIL.Tests.UnverifiableAssemblyToProcess\InlineIL.Tests.UnverifiableAssemblyToProcess.csproj" />

    <InlineILTestProject Update="@(InlineILTestProject)" Visible="false" />
    <ProjectReference Include="@(InlineILTestProject)" ReferenceOutputAssembly="false" OutputItemType="InlineILTestProjectAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InlineIL.Tests.InjectedAssembly\InlineIL.Tests.InjectedAssembly.csproj" />

    <ProjectReference Include="..\InlineIL.Tests.InjectedAssembly\InlineIL.Tests.InjectedAssembly.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="None" CopyToOutputDirectory="PreserveNewest"
                      TargetPath="TestAssemblies/Injections/InlineIL.Tests.InjectedAssembly.dll" />

    <ProjectReference Include="..\InlineIL.Tests.InjectedAssembly.Alternative\InlineIL.Tests.InjectedAssembly.Alternative.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="None" CopyToOutputDirectory="PreserveNewest"
                      TargetPath="TestAssemblies/Injections/InlineIL.Tests.InjectedAssembly.Alternative.dll" />
  </ItemGroup>

  <Target Name="InlineILAddTestAssemblies"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <ContentWithTargetPath Include="@(InlineILTestProjectAssembly)"
                             CopyToOutputDirectory="PreserveNewest"
                             TargetPath="TestAssemblies/Input/%(Filename)%(Extension)" />

      <ContentWithTargetPath Include="@(InlineILTestProjectAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
                             CopyToOutputDirectory="PreserveNewest"
                             TargetPath="TestAssemblies/Input/%(Filename).pdb" />

      <ContentWithTargetPath Include="@(InlineILTestProjectAssembly->'%(RootDir)%(Directory)%(Filename).refs.txt')"
                             CopyToOutputDirectory="PreserveNewest"
                             TargetPath="TestAssemblies/Input/%(Filename).refs.txt" />
    </ItemGroup>
  </Target>

</Project>
